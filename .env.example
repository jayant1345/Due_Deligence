# Environment Configuration for CA Loan Verification Platform

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ca_loan_verification

# Redis & Celery (Railway Redis)
REDIS_URL=redis://localhost:6379/0

# Security (Argon2 & JWT)
SECRET_KEY=railway-production-super-secret-jwt-signing-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenRouter Gemini Vision OCR (Cost-Effective & High-Accuracy Scanning)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Storage (local, s3, r2)
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=storage_uploads
S3_BUCKET_NAME=ca-verification-vault
AWS_REGION=ap-south-1

# CA Firm Details
CA_FIRM_NAME=VALUEX & CO. CHARTERED ACCOUNTANTS
CA_FRN=128490W
CA_PARTNER_NAME=CA Rohan Parekh, FCA
CA_MEMBERSHIP_NO=094821
